# ─────────────────────────────────────────────────────────────
# PicoSEO environment template
# Copy to `.env` for local development. On Vercel, add each key under
# Project → Settings → Environment Variables (Production + Preview).
# ─────────────────────────────────────────────────────────────

# Partner Dashboard → Apps → PicoSEO → Client credentials
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_client_secret

# Public HTTPS origin of the deployed app (no trailing slash).
# Locally the Shopify CLI injects this automatically.
SHOPIFY_APP_URL=https://pico-seo-shopify-app.vercel.app

# Must match [access_scopes] in shopify.app.toml
SCOPES=read_products,write_products,read_themes,write_themes,read_content,write_content,read_files,write_files,read_online_store_navigation,write_online_store_navigation

# App handle from shopify.app.toml — used to build billing return URLs.
SHOPIFY_APP_HANDLE=picoseo

# Pooled Postgres connection string (Neon / Supabase / Vercel Postgres free tier).
DATABASE_URL=postgresql://user:password@host:5432/picoseo?sslmode=require

# "true" creates Shopify test charges (no real money). Set to "false" in production.
SHOPIFY_BILLING_TEST=true

# Optional: custom shop domain allow-list for local testing
# SHOP_CUSTOM_DOMAIN=
