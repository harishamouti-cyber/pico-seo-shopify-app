{
  "name": "pico-seo-shopify-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PicoSEO — zero-bloat Shopify SEO, schema, IndexNow and AI-search (/llms.txt) app.",
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "env": "shopify app env",
    "start": "remix-serve ./build/server/index.js",
    "setup": "prisma generate && prisma db push",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && remix vite:build",
    "shopify": "shopify",
    "prisma": "prisma"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@remix-run/dev": "2.16.7",
    "@remix-run/node": "2.16.7",
    "@remix-run/react": "2.16.7",
    "@remix-run/serve": "2.16.7",
    "@remix-run/server-runtime": "2.16.7",
    "@shopify/app-bridge-react": "^4.2.13",
    "@shopify/polaris": "^12.27.0",
    "@shopify/shopify-app-remix": "3.8.3",
    "@shopify/shopify-app-session-storage-prisma": "^6.0.0",
    "@vercel/remix": "2.16.7",
    "isbot": "^5.1.26",
    "prisma": "^6.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/app-bridge-types": "^0.0.18",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.19"
  },
  "overrides": {
    "@remix-run/server-runtime": "2.16.7"
  },
  "author": "harishamouti-cyber",
  "license": "UNLICENSED"
}
